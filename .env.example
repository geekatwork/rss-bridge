# Database
POSTGRES_DB=rss_bridge
POSTGRES_USER=rss_bridge
POSTGRES_PASSWORD=changeme

# Ports (host-side)
DB_PORT=5433
FEED_PORT=3100

# Public feed origin and optional reverse-proxy prefix (not the container port).
# Omit to use http://localhost:${FEED_PORT:-3100}.
# FEED_BASE_URL=https://feeds.example.com/rss

# Scraper
SCRAPE_GROUPS=[{"groupId":"100000000000001","siteId":"facebook","name":"Demo Group One","url":"https://www.facebook.com/groups/100000000000001"},{"groupId":"100000000000002","siteId":"facebook","name":"Demo Group Two","url":"https://www.facebook.com/groups/100000000000002"}]
SCRAPE_SCHEDULE=0 * * * *
# Global fallback; per-group options.cookieFile takes precedence (container path).
# SOURCE_COOKIE_FILE=/app/cookies/facebook/fb_cookies.json
SCRAPE_GROUP_TIMEOUT_MS=1200000
FACEBOOK_BOUNDARY_FALLBACK_LIMIT=50
